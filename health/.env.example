# ── AI (required for analysis) — same OpenRouter key as the Tone Analyser
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model ids)
# AI_MODEL_FAST=anthropic/claude-sonnet-5.5
# AI_MODEL_DEEP=anthropic/claude-opus-5.5

# ── Private cloud storage + login (optional — without these the app runs in demo mode, data stays in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Demo mode only: protects the AI routes of a public demo deployment
# APP_PASSCODE=
